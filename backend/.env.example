# SovereignAI backend configuration. Do not commit a real production secret.
SOVEREIGNAI_ENVIRONMENT=development
SOVEREIGNAI_DATABASE_URL=sqlite:///./.sovereignai_runtime/api.db
# For Docker/production use PostgreSQL, for example:
# SOVEREIGNAI_DATABASE_URL=postgresql+psycopg://sovereignai:CHANGE_ME@localhost:5432/sovereignai
SOVEREIGNAI_REDIS_URL=redis://localhost:6379/0
# Celery defaults to SOVEREIGNAI_REDIS_URL when these are unset.
SOVEREIGNAI_CELERY_BROKER_URL=
SOVEREIGNAI_CELERY_RESULT_BACKEND=
# Must be a unique 32+ character secret in production.
SOVEREIGNAI_JWT_SECRET=replace-with-a-unique-32-character-minimum-secret
SOVEREIGNAI_ACCESS_TOKEN_MINUTES=15
SOVEREIGNAI_REFRESH_TOKEN_DAYS=14
SOVEREIGNAI_UPLOAD_DIR=.sovereignai_runtime/uploads
SOVEREIGNAI_MAX_UPLOAD_BYTES=52428800
SOVEREIGNAI_ALLOWED_ORIGINS=["http://localhost:5173"]
