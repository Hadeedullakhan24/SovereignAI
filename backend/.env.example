APP_NAME=SovereignAI Integration API
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./storage/sovereignai.db
# Set a unique 32+ character secret in deployment; never commit .env.
JWT_SECRET_KEY=replace-with-a-unique-32-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
TEMP_DIR=storage/temporary
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CLEANUP_AGE_HOURS=24
